{
  "id": "myrealm",
  "realm": "myrealm",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access" },
      { "name": "user", "description": "Basic user role" },
      { "name": "study_A_researcher", "description": "Can access Study A data" },
      { "name": "study_B_researcher", "description": "Can access Study B data" }
    ]
  },
  "clients": [
    {
      "clientId": "webapp",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "defaultRoles": [],
      "webOrigins": ["*"],
      "attributes": {
        "oidc.ciba.grant.enabled": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "hospital1-broker",
      "enabled": true,
      "publicClient": false,
      "secret": "hospital1-broker-secret",
      "redirectUris": ["*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "webOrigins": ["*"],
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "hospital2-broker",
      "enabled": true,
      "publicClient": false,
      "secret": "hospital2-broker-secret",
      "redirectUris": ["*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "webOrigins": ["*"],
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "enabled": true,
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Anderson",
      "email": "alice@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "study_A_researcher"],
      "requiredActions": []
    },
    {
      "enabled": true,
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Brown",
      "email": "bob@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "study_B_researcher"],
      "requiredActions": []
    },
    {
      "enabled": true,
      "username": "carol",
      "firstName": "Carol",
      "lastName": "Clark",
      "email": "carol@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "carol",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "study_A_researcher", "study_B_researcher"],
      "requiredActions": []
    },
    {
      "enabled": true,
      "username": "dave",
      "firstName": "Dave",
      "lastName": "Davis",
      "email": "dave@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dave",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"],
      "requiredActions": []
    }
  ]
}
