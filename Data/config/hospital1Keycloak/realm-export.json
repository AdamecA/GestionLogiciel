{
  "id": "hospital1-realm",
  "realm": "hospital1-realm",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "user" },
      { "name": "manager" },
      { "name": "developer" },
      { "name": "guest" },
      { "name": "hospital-staff" },
      { "name": "doctor" },
      { "name": "nurse" },
      { "name": "study_A_researcher", "description": "Can access study_A data" },
      { "name": "study_B_researcher", "description": "Can access study_B data" },
      { "name": "senior_researcher", "description": "Can access all studies" }
    ]
  },
  "clients": [
    {
      "clientId": "hospital-proxy",
      "enabled": true,
      "publicClient": false,
      "secret": "hospital1-secret",
      "redirectUris": ["*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "defaultRoles": [],
      "webOrigins": ["*"],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "study_A",
            "type": "urn:hospital-proxy:resources:study",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/study/A"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          },
          {
            "name": "study_B",
            "type": "urn:hospital-proxy:resources:study",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/study/B"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          },
          {
            "name": "patient_data",
            "type": "urn:hospital-proxy:resources:patient",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/patient/*"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          }
        ],
        "policies": [
          {
            "name": "Study A Researcher Policy",
            "description": "Policy for study_A researchers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"study_A_researcher\",\"required\":true}]"
            }
          },
          {
            "name": "Study B Researcher Policy",
            "description": "Policy for study_B researchers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"study_B_researcher\",\"required\":true}]"
            }
          },
          {
            "name": "Senior Researcher Policy",
            "description": "Policy for senior researchers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"senior_researcher\",\"required\":true}]"
            }
          },
          {
            "name": "Admin Policy",
            "description": "Policy for administrators",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"admin\",\"required\":true}]"
            }
          }
        ],
        "scopes": [
          {"name": "read"},
          {"name": "write"}
        ]
      }
    }
  ],
