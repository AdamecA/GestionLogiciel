{
  "id": "hospital2-realm",
  "realm": "hospital2-realm",
  "enabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "identityProviders": [
    {
      "alias": "central-keycloak",
      "displayName": "Central Keycloak",
      "providerId": "keycloak-oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": true,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "tokenUrl": "http://keycloak-central:8080/realms/myrealm/protocol/openid-connect/token",
        "authorizationUrl": "http://keycloak-central:8080/realms/myrealm/protocol/openid-connect/auth",
        "logoutUrl": "http://keycloak-central:8080/realms/myrealm/protocol/openid-connect/logout",
        "userInfoUrl": "http://keycloak-central:8080/realms/myrealm/protocol/openid-connect/userinfo",
        "jwksUrl": "http://keycloak-central:8080/realms/myrealm/protocol/openid-connect/certs",
        "issuer": "http://localhost:8080/realms/myrealm",
        "clientId": "hospital2-broker",
        "clientSecret": "hospital2-broker-secret",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "study_A_researcher role mapper",
      "identityProviderAlias": "central-keycloak",
      "identityProviderMapper": "oidc-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "realm_access.roles",
        "claim.value": "study_A_researcher",
        "role": "study_A_researcher"
      }
    },
    {
      "name": "study_B_researcher role mapper",
      "identityProviderAlias": "central-keycloak",
      "identityProviderMapper": "oidc-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "realm_access.roles",
        "claim.value": "study_B_researcher",
        "role": "study_B_researcher"
      }
    },
    {
      "name": "admin role mapper",
      "identityProviderAlias": "central-keycloak",
      "identityProviderMapper": "oidc-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "realm_access.roles",
        "claim.value": "admin",
        "role": "admin"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access to all resources" },
      { "name": "study_A_researcher", "description": "Can access study_A data" },
      { "name": "study_B_researcher", "description": "Can access study_B data" }
    ]
  },
  "clients": [
    {
      "clientId": "hospital-proxy",
      "enabled": true,
      "publicClient": false,
      "secret": "hospital2-secret",
      "redirectUris": ["*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "defaultRoles": [],
      "webOrigins": ["*"],
      "attributes": {
        "token.exchange.standard.flow.enabled": "true"
      },
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "study_A",
            "type": "urn:hospital-proxy:resources:study",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/study/A"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          },
          {
            "name": "study_B",
            "type": "urn:hospital-proxy:resources:study",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/study/B"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          },
          {
            "name": "patient_data",
            "type": "urn:hospital-proxy:resources:patient",
            "ownerManagedAccess": false,
            "attributes": {},
            "uris": ["/patient/*"],
            "scopes": [
              {"name": "read"},
              {"name": "write"}
            ]
          }
        ],
        "policies": [
          {
            "name": "Study A Researcher Policy",
            "description": "Policy for study_A researchers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"study_A_researcher\",\"required\":true}]"
            }
          },
          {
            "name": "Study B Researcher Policy",
            "description": "Policy for study_B researchers",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"study_B_researcher\",\"required\":true}]"
            }
          },
          {
            "name": "Admin Policy",
            "description": "Policy for administrators",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"admin\",\"required\":true}]"
            }
          },
          {
            "name": "Study A Permission",
            "description": "Permission to access Study A",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"study_A\"]",
              "applyPolicies": "[\"Study A Researcher Policy\",\"Admin Policy\"]"
            }
          },
          {
            "name": "Study B Permission",
            "description": "Permission to access Study B",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"study_B\"]",
              "applyPolicies": "[\"Study B Researcher Policy\",\"Admin Policy\"]"
            }
          },
          {
            "name": "Patient Data Permission",
            "description": "Permission to access Patient Data",
            "type": "resource",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "resources": "[\"patient_data\"]",
              "applyPolicies": "[\"Study A Researcher Policy\",\"Study B Researcher Policy\",\"Admin Policy\"]"
            }
          }
        ],
        "scopes": [
          {"name": "read"},
          {"name": "write"}
        ]
      }
    }
  ],
  "users": []
}
